POSTGRES_DB=fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
FRAUD_API_KEY=local-dev-key

# Everything below is optional. Each line shows the default; uncomment it to change the value.
# Durations take a unit: 10m, 2h, 30d.
# FRAUD_MAX_EVENT_AGE=45d
# FRAUD_CLOCK_SKEW=5m
# FRAUD_API_DEFAULT_PAGE_SIZE=20
# FRAUD_API_MAX_PAGE_SIZE=100
# FRAUD_REVIEW_FROM=40
# FRAUD_HIGH_RISK_FROM=80

# FRAUD_HIGH_AMOUNT_ENABLED=true
# FRAUD_HIGH_AMOUNT_SCORE=40
# Minor units: 5000000 is R50,000.00
# FRAUD_HIGH_AMOUNT_ZAR=5000000
# FRAUD_HIGH_AMOUNT_USD=300000
# FRAUD_HIGH_AMOUNT_EUR=300000
# FRAUD_HIGH_AMOUNT_GBP=250000

# FRAUD_AMOUNT_ANOMALY_ENABLED=true
# FRAUD_AMOUNT_ANOMALY_SCORE=50
# FRAUD_AMOUNT_ANOMALY_MIN_HISTORY=10
# FRAUD_AMOUNT_ANOMALY_LOOKBACK=30d
# FRAUD_AMOUNT_ANOMALY_STDDEV_MULTIPLIER=3
# FRAUD_AMOUNT_ANOMALY_REPEAT_MIN_AGE=25d
# FRAUD_AMOUNT_ANOMALY_REPEAT_MAX_AGE=35d

# FRAUD_VELOCITY_ENABLED=true
# FRAUD_VELOCITY_SCORE=40
# FRAUD_VELOCITY_MAX_COUNT=5
# FRAUD_VELOCITY_WINDOW=10m

# FRAUD_COUNTRY_HOP_ENABLED=true
# FRAUD_COUNTRY_HOP_SCORE=80
# FRAUD_COUNTRY_HOP_WINDOW=2h

# FRAUD_HIGH_RISK_CATEGORY_ENABLED=true
# FRAUD_HIGH_RISK_CATEGORY_SCORE=20
# FRAUD_HIGH_RISK_CATEGORIES=GAMBLING,CRYPTO,MONEY_TRANSFER
